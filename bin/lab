#!/usr/bin/env bun
import { runLab } from "../packages/lab/src/server";

try {
  const app = runLab(Bun.argv.slice(2));
  let stopping = false;
  const stop = () => {
    if (stopping) return;
    stopping = true;
    app.stop();
  };
  process.once("SIGINT", stop);
  process.once("SIGTERM", stop);
} catch (error) {
  console.error(`lab: ${error instanceof Error ? error.message : String(error)}`);
  process.exitCode = 1;
}
